# Express Backend Port
PORT=5000

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/activitytracker_rcpit

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Initial System Admin Bootstrap Credentials (Optional)
ADMIN_EMAIL=admin@rcpit.ac.in
ADMIN_PASSWORD=Admin@rcpit2026

# Nodemailer SMTP Credentials for Email Notifications
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@rcpit.ac.in
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=ActiTracker RCPIT
