# Environment files (NEVER commit secrets or real credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build outputs
dist/
frontend/dist/
backend/dist/

# Local uploaded files (ignore uploaded user content, preserve directory structure)
backend/public/uploads/*
!backend/public/uploads/.gitkeep
backend/public/uploads/documents/*
!backend/public/uploads/documents/.gitkeep
backend/public/uploads/identity-cards/*
!backend/public/uploads/identity-cards/.gitkeep
backend/public/uploads/images/*
!backend/public/uploads/images/.gitkeep
backend/public/uploads/reports/*
!backend/public/uploads/reports/.gitkeep
backend/public/uploads/verification-documents/*
!backend/public/uploads/verification-documents/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# IDE & OS & Logs
.vscode/
.idea/
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
